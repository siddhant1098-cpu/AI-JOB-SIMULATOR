GOOGLE_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-2.5-flash

# CrewAI Multi-Agent Orchestration Configuration
# Set to 'true' if you wish to run an optional quality reviewer agent (consumes additional Gemini free-tier quota)
ENABLE_CREW_QUALITY_REVIEWER=false

# ElevenLabs Text-to-Speech Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_DEFAULT_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Optional: Override voice IDs for specific characters
# ELEVENLABS_VOICE_INTERVIEWER=
# ELEVENLABS_VOICE_COWORKER=
# ELEVENLABS_VOICE_TEAM_LEADER=
# ELEVENLABS_VOICE_MANAGER=
# ELEVENLABS_VOICE_EXECUTIVE=
# ELEVENLABS_VOICE_CLIENT=
# ELEVENLABS_VOICE_UPSET_CLIENT=
